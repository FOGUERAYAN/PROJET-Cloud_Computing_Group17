# Variables du contrat d'interface entre l'application et l'infrastructure.
# Copier ce fichier vers .env puis remplir les valeurs. Ne jamais versionner .env.
# Le port de l'application est fixé à 8000 dans le Dockerfile.

# memoire (sans stockage externe), azurite (local avec docker compose) ou azure (Managed Identity).
STORAGE_MODE=azurite

# Mode azure : nom du compte de stockage, sans URL ni clé.
AZURE_STORAGE_ACCOUNT_NAME=

# Clé de signature des sessions et des liens de partage. Obligatoire.
# Sur la VM, injectée au démarrage depuis le Key Vault. En local, générer une valeur longue et aléatoire :
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Prévue par le contrat, pas encore lue par l'application.
KEY_VAULT_URL=

# Prévue par le contrat, pas encore lue par l'application.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Seulement si l'identité managée de la VM est user-assigned (lue par DefaultAzureCredential).
AZURE_CLIENT_ID=

# Contact de l'équipe envoyé à Wikimedia par scripts/telecharger_photos.py (User-Agent).
PHOTOS_CONTACT=
