# Copier ce fichier vers .env puis remplir les valeurs. Ne jamais versionner .env.

# Clé de signature des sessions Flask. Générer une valeur longue et aléatoire :
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port de la machine hôte pour docker compose (8000 par défaut).
APP_PORT=8000

# memoire (sans stockage externe), azurite (local) ou azure (Managed Identity)
STORAGE_MODE=azurite

# Mode azurite uniquement. Ne jamais mettre de clé de compte ici.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Mode azure uniquement : nom du compte de stockage (pas de clé).
AZURE_STORAGE_ACCOUNT_NAME=

# Contact de l'équipe envoyé à Wikimedia par scripts/telecharger_photos.py (User-Agent).
PHOTOS_CONTACT=
